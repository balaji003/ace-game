# Production environment example — copy to .env on the deployed host.

# Server
APP_ENV=prod
PORT=8080
# REQUIRED in prod — comma-separated allow-list (wildcard is refused at startup).
# ACE is Android-only today, so this is just the Android WebView origin
# (https://localhost, set by androidScheme in fe/capacitor.config.json).
# Add capacitor://localhost when iOS ships, and a web domain if one is ever hosted.
ALLOW_ORIGIN=https://localhost

# MySQL
DB_USER=aceuser
DB_PASS=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ace

# Auth — generate a long random string, e.g.  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret

# Gameplay timers (seconds)
WATCH_COUNTDOWN_SECS=10
AFK_WARN_SECS=20
AFK_GRACE_SECS=10
MAX_TURN_RETRIES=3
MIN_PLAYERS=3
MAX_PLAYERS=7

# History
RECENT_GAMES_LIMIT=10
