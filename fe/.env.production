# Frontend production build config (Vite auto-loads for `vite build`).
# Point these at your deployed backend domain.
VITE_APP_ENV=production
VITE_API_URL=https://ace-be.up.railway.app
VITE_WS_URL=wss://ace-be.up.railway.app
