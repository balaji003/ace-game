{
  "appId": "com.playacecard.ace",
  "appName": "ACE",
  "webDir": "dist",
  "backgroundColor": "#0a2e1c",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      }
    },
    "SplashScreen": {
      "backgroundColor": "#0a2e1c",
      "showSpinner": false,
      "launchAutoHide": true,
      "launchShowDuration": 3000
    }
  }
}
